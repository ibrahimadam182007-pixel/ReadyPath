# Database (PostgreSQL - Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/readypath?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/readypath?schema=public"

# Authentication (NextAuth / Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Email Delivery (Resend)
RESEND_API_KEY="re_sample_key_here"
EMAIL_FROM="ReadyPath <notifications@readypath.app>"

# Scheduled Cron Security
CRON_SECRET="your-cron-secret-bearer-token"

# App Public Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ReadyPath"
