# ---------- Database (PostgreSQL: Neon / Supabase) ----------
# DATABASE_URL = pooled connection (used by the app), DIRECT_URL = direct connection (used by prisma db push).
DATABASE_URL="postgresql://postgres:password@localhost:5432/readypath?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/readypath?schema=public"

# ---------- Auth (NextAuth v4, email + password) ----------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Optional: restrict sign-ups to these email domains (comma-separated). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=""

# ---------- Optional Google sign-in (leave empty to disable) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ---------- Email reminders ----------
# EMAIL_PROVIDER: resend | smtp | console (console = log only, nothing is sent)
EMAIL_PROVIDER="console"
EMAIL_FROM="ReadyPath <no-reply@example.com>"
# Resend (needs a verified sending domain to email anyone besides your own account)
RESEND_API_KEY=""
# SMTP (e.g. Gmail with an app password: smtp.gmail.com / 465 / secure=true)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ---------- Cron (Vercel Cron sends this as a Bearer token) ----------
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ReadyPath"
# "true" = start new visitors with the demo student (Naufal) instead of an empty profile
NEXT_PUBLIC_DEMO_MODE="false"
