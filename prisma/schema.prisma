// ReadyPath - PostgreSQL Database Schema (User + Beasiswa/Magang + Countdown Planner)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum DegreeLevel {
  D3
  D4
  S1
  S2
}

enum CertificateCategory {
  ENGLISH_PROFICIENCY // TOEFL iBT, IELTS, Duolingo, TOEIC
  OTHER_LANGUAGE      // JLPT, TOPIK, HSK, Goethe
  TECHNICAL_CLOUD     // AWS, GCP, Azure, CompTIA
  DOMAIN_PROFESSIONAL // Google Career Cert, CFA, Project Management
  COMPETITION_AWARD   // Juara lomba / Hackathon
}

enum ExperienceCategory {
  INTERNSHIP
  ORGANIZATION
  VOLUNTEER
  RESEARCH_PROJECT
  FREELANCE_WORK
}

enum OpportunityCategory {
  SCHOLARSHIP // Beasiswa Dalam & Luar Negeri
  INTERNSHIP  // Magang Reguler & MBKM
  EXCHANGE    // Student Exchange / Mobility (misal IISMA)
  FELLOWSHIP  // Leadership / Career Fellowship
}

enum ScholarshipCoverageType {
  FULL           // Fully Funded (UKT + Uang Saku + Fasilitas)
  PARTIAL        // Partial Funded (Hanya UKT atau sebagian komponen)
  ALLOWANCE_ONLY // Bantuan Uang Saku / Biaya Hidup saja
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ONSITE
}

enum StipendType {
  PAID           // Uang saku / Gaji bulanan
  UNPAID         // Tanpa uang saku
  SKS_CONVERSION // Konversi SKS (MBKM) + Uang Saku
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MilestoneType {
  TARGET_SEMESTER_GPA     // Target IPK semester depan untuk menutup gap
  CERTIFICATE_ACQUISITION // Batas waktu ambil ujian sertifikat baru
  CERTIFICATE_RENEWAL     // Batas waktu perpanjangan sertifikat yang akan expired
  EXPERIENCE_BUILDING     // Pemenuhan durasi pengalaman kerja/organisasi
  DOCUMENT_DRAFT          // Persiapan berkas administrasi
  FINAL_SUBMISSION        // Pengiriman pendaftaran sebelum deadline
}

// ============================================================================
// 1. USER & STUDENT PROFILE DATABASE
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  studentProfile StudentProfile?
  targetPlans    TargetPlan[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StudentProfile {
  id                    String      @id @default(cuid())
  userId                String      @unique
  university            String?
  major                 String?     // Contoh: "Teknik Informatika", "Manajemen"
  degreeLevel           DegreeLevel @default(S1)
  currentSemester       Int         // Contoh: 4 (antara 1 - 14)
  cumulativeGpa         Decimal     @db.Decimal(3, 2) // Contoh: 3.45 (skala 4.00)
  totalCreditsCompleted Int?        // SKS yang telah ditempuh (opsional untuk presisi hitung IPK)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificates StudentCertificate[]
  experiences  StudentExperience[]

  @@index([currentSemester, cumulativeGpa])
}

model StudentCertificate {
  id            String              @id @default(cuid())
  profileId     String
  name          String              // Contoh: "TOEFL iBT", "IELTS Academic", "AWS Certified Cloud Practitioner"
  standardCode  String              // Kode terstandarisasi untuk pencocokan rule: "TOEFL_IBT", "IELTS", "DUOLINGO", "JLPT_N2", dll
  category      CertificateCategory @default(ENGLISH_PROFICIENCY)
  issuer        String?             // Contoh: "ETS", "British Council", "Amazon Web Services"
  score         Decimal?            @db.Decimal(6, 2) // Contoh: 85.00 (TOEFL), 6.50 (IELTS)
  issueDate     DateTime?
  expiryDate    DateTime            // Wajib ada untuk validasi masa berlaku terhadap deadline peluang
  credentialUrl String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, standardCode])
  @@index([expiryDate])
}

model StudentExperience {
  id             String             @id @default(cuid())
  profileId      String
  role           String             // Contoh: "Software Engineer Intern", "Ketua Divisi Acara"
  organization   String             // Contoh: "Tokopedia", "BEM Fakultas Ilmu Komputer"
  category       ExperienceCategory @default(ORGANIZATION)
  durationMonths Int                // Durasi terukur dalam bulan (contoh: 6)
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean            @default(false)
  description    String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, category])
}

// ============================================================================
// 2. BEASISWA & MAGANG (OPPORTUNITY) DATABASE
// ============================================================================

model Opportunity {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String              // Contoh: "IISMA 2027", "Beasiswa Unggulan Kemendikbud"
  provider         String              // Contoh: "Kemendikbudristek", "Bank Indonesia", "GoTo Group"
  category         OpportunityCategory
  summary          String              @db.Text
  openDate         DateTime?           // Perkiraan/tanggal pembukaan pendaftaran
  deadline         DateTime            // Tanggal penutupan pendaftaran resmi
  announcementDate DateTime?
  sourceUrl        String              // Link sumber resmi pengumuman
  lastVerifiedAt   DateTime            // Tanggal terakhir diverifikasi tim kurasi
  isPrototype      Boolean             @default(true) // Ditandai sebagai prototype data di V1
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations: 1-to-1 Rule & Specific Category Details
  rule              OpportunityRule?
  scholarshipDetail ScholarshipDetail?
  internshipDetail  InternshipDetail?
  targetPlans       TargetPlan[]

  @@index([category, deadline])
  @@index([isActive])
}

model OpportunityRule {
  id                   String        @id @default(cuid())
  opportunityId        String        @unique
  minSemester          Int           @default(1)
  maxSemester          Int           @default(8)
  minGpa               Decimal       @db.Decimal(3, 2) // Contoh: 3.00, 3.25, 3.50
  minExperienceMonths  Int           @default(0)       // Total minimal bulan pengalaman relevan
  allowedExperienceCategories ExperienceCategory[]     // Jika kosong berarti semua kategori pengalaman dihitung
  targetDegrees        DegreeLevel[]                   // Contoh: [D4, S1]
  eligibleMajors       String[]                        // Contoh: ["ALL"] atau ["Informatika", "Sistem Informasi"]
  
  // JSONB terstruktur untuk persyaratan sertifikat:
  // Contoh: [{ "category": "ENGLISH_PROFICIENCY", "label": "Sertifikat Bahasa Inggris", "acceptedCodes": [{"code": "TOEFL_IBT", "minScore": 78}, {"code": "IELTS", "minScore": 6.0}], "mustBeValidUntilDaysAfterDeadline": 0, "estPrepAndResultDays": 45 }]
  requiredCertificates Json          @default("[]")

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model ScholarshipDetail {
  id                    String                  @id @default(cuid())
  opportunityId         String                  @unique
  coverageType          ScholarshipCoverageType @default(FULL)
  coversTuitionFee      Boolean                 @default(true)
  allowancePerMonth     Decimal?                @db.Decimal(12, 2) // Nominal uang saku bulanan
  currency              String                  @default("IDR")
  fundingDurationMonths Int?                    // Contoh: 6 bulan (exchange) atau 24 bulan (4 semester)
  destinationCountry    String                  @default("Indonesia")
  hasServiceBond        Boolean                 @default(false)    // Apakah ada ikatan dinas
  serviceBondDetails    String?                 @db.Text
  benefitsList          String[]                // Daftar benefit: ["Biaya Pendidikan UKT", "Tunjangan Hidup", "Tiket Pesawat PP"]

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model InternshipDetail {
  id              String          @id @default(cuid())
  opportunityId   String          @unique
  workArrangement WorkArrangement @default(HYBRID)
  location        String          // Contoh: "Jakarta Selatan", "Remote - Indonesia"
  stipendType     StipendType     @default(PAID)
  stipendAmount   Decimal?        @db.Decimal(12, 2)
  currency        String          @default("IDR")
  durationMonths  Int             // Contoh: 3, 5, atau 6 bulan
  division        String          // Contoh: "Software Engineering", "Data Science", "Product Management"
  requiredSkills  String[]        // Contoh: ["TypeScript", "React", "SQL", "Git"]
  isMbkmEligible  Boolean         @default(false) // Apakah bisa konversi 20 SKS MBKM

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 3. COUNTDOWN PLAN & REMINDER DATABASE
// ============================================================================

model TargetPlan {
  id                   String     @id @default(cuid())
  userId               String
  opportunityId        String
  status               PlanStatus @default(ACTIVE)
  
  // Snapshot kalkulasi saat plan dibuat/diperbarui
  isFullyEligible      Boolean    @default(false)
  requiredNextTermGpa  Decimal?   @db.Decimal(3, 2) // Hasil kalkulasi IPK semester depan yang dibutuhkan
  
  // Pengaturan pengingat email
  remindersEnabled     Boolean    @default(true)
  reminderEmail        String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  milestones  PlanMilestone[]

  @@unique([userId, opportunityId])
  @@index([userId, status])
  @@index([remindersEnabled])
}

model PlanMilestone {
  id                 String        @id @default(cuid())
  planId             String
  title              String        // Contoh: "Ambil Tes IELTS / TOEFL iBT"
  description        String        @db.Text
  type               MilestoneType
  targetDate         DateTime      // Tanggal batas mundur yang dihitung dari deadline
  daysBeforeDeadline Int           // Contoh: 45 (H-45 sebelum deadline)
  isCompleted        Boolean       @default(false)
  completedAt        DateTime?
  reminderSentAt     DateTime?     // Diisi oleh Cron Job saat email pengingat dikirim
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  plan TargetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, targetDate])
  @@index([targetDate, isCompleted, reminderSentAt])
}
